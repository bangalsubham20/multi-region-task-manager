# ==========================================
# Multi-Region Task Manager - .gitignore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
secrets/

# Log Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node.js / Frontend / Backend (JavaScript/TypeScript)
node_modules/
jspm_packages/
.npm
.eslintcache
.stylelintcache
.next/
.nuxt/
dist/
build/
out/
.cache/
.parcel-cache/
coverage/
.nyc_output/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Java / Kotlin
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
vendor/

# Terraform / Infrastructure
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
*.tfvars
*.tfvars.json

# Docker & Container artifacts
*.tar
*.gz

# Antigravity / Temporary AI Brain Files
.gemini/
